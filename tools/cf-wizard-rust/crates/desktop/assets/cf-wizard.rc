#include "cf-wizard-version.h"

1 ICON "cf-wizard.ico"

1 VERSIONINFO
FILEVERSION CF_WIZARD_VERSION_NUM
PRODUCTVERSION CF_WIZARD_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "CF Wizard\0"
            VALUE "FileVersion", CF_WIZARD_VERSION_TEXT
            VALUE "ProductName", "CF Wizard\0"
            VALUE "ProductVersion", CF_WIZARD_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
